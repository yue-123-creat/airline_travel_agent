# ============================================================
# airline_travel_agent 环境变量模板
# 编码：UTF-8 无 BOM（旧版本曾因 GBK 乱码 + 换行丢失，把若干 KEY 吞进注释行，已重建）
# 用法： cp .env.example .env  然后填写所有 <必填> 项
# 说明： 本文件会被 docker-compose 的 env_file 读取；
#        docker-compose.prod.yml 会用其中 POSTGRES_* 派生 DATABASE_URL。
# ============================================================

# ---------- 必填密钥（不要提交到仓库，.dockerignore 已排除 .env） ----------
DASHSCOPE_API_KEY=<必填-阿里云百炼API-KEY>
ADMIN_TOKEN=<必填-管理端点口令-换成随机长串>

# ---------- 生产专用：数据库凭据 ----------
# docker-compose.prod.yml 强制要求 POSTGRES_PASSWORD 存在，否则拒绝启动。
# 修改它时无需改 DATABASE_URL：compose 会用下面三个值自动拼出容器内连接串。
POSTGRES_USER=qa
POSTGRES_PASSWORD=<必填-强口令-例如 openssl rand -base64 24 生成>
POSTGRES_DB=travel_qa

# ---------- LLM / 通义千问 ----------
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-flash
QWEN_INGEST_MODEL=qwen-turbo
QWEN_INGEST_MAX_TOKENS=256
QWEN_CHAT_MAX_TOKENS=220
QWEN_TRAVEL_REPLY_MAX_TOKENS=560
QWEN_TRAVEL_GUIDE_MAX_TOKENS=900
QWEN_AVIATION_MAX_TOKENS=480
QWEN_SUMMARY_MAX_TOKENS=256
QWEN_TEMPERATURE=0.15

# ---------- 地图 POI ----------
# MAP_PROVIDER=tencent|amap；腾讯地图为优先，高德为备选
MAP_PROVIDER=tencent
TENCENT_MAP_KEY=<腾讯地图KEY>
TENCENT_MAP_BASE_URL=https://apis.map.qq.com
TENCENT_PLACE_SEARCH_PATH=/ws/place/v1/search
AMAP_API_KEY=<高德Web服务KEY>
AMAP_BASE_URL=https://restapi.amap.com
AMAP_PLACE_TEXT_PATH=/v3/place/text
AMAP_PLACE_AROUND_PATH=/v3/place/around
AMAP_DISTANCE_PATH=/v3/distance
AMAP_DIRECTION_DRIVING_PATH=/v3/direction/driving
AMAP_DIRECTION_WALKING_PATH=/v3/direction/walking
AMAP_EXTENSIONS=all

# ---------- 和风天气 ----------
# 控制台自定义 API Host；请求头 X-QW-Api-Key
QWEATHER_API_KEY=<和风天气KEY>
QWEATHER_BASE_URL=https://your-api-host.qweatherapi.com
QWEATHER_DAILY_PATH=/weather/v1/daily
QWEATHER_TIMEOUT_SEC=4.0
QWEATHER_CACHE_TTL_SEC=1800
QWEATHER_MAX_CITIES=4

# ---------- 旅游知识源 ----------
# legacy = 文件旧库 travel_knowledge.json；enriched = Postgres attraction_kb（正式路径）
TRAVEL_KNOWLEDGE_SOURCE=enriched

# ---------- 服务 / 网络 ----------
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
# 下面两个是「宿主机直跑」用；compose 内会被 environment 覆盖成容器内网主机名
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=postgresql://qa:qa@127.0.0.1:5432/travel_qa

# ---------- P2 向量库 Qdrant ----------
# compose 内 api 使用 http://qdrant:6333；本机脚本用 127.0.0.1
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_TRAVEL_COLLECTION=travel_rag
QDRANT_AVIATION_COLLECTION=aviation_rag
QDRANT_VECTOR_SIZE=1024
# 向量模型 ≠ QWEN_CHAT_MODEL；换模型/维度后必须重建 Collection 并全量重灌
QWEN_EMBED_MODEL=text-embedding-v3
RAG_TOP_K_ANCHORED=3
RAG_TOP_K_DEGRADED=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# Batch 4 混合检索预留（检索侧尚未接线）
RAG_BM25_TOP_K=20
RAG_VECTOR_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_N=15
RAG_RERANK_KEEP=5
RAG_RERANK_ENABLED=false
RAG_RERANK_MIN_CANDIDATES=8
RAG_RERANK_MODEL=bge-reranker-large

# ---------- 配额 ----------
QUOTA_DAILY_TOKENS=200000
QUOTA_MONTHLY_TOKENS=2000000
QUOTA_SESSION_TURNS=50
QUOTA_RESERVE_TTL_SEC=60
QUOTA_EST_DEFAULT=1200

# ---------- 路由 / STM ----------
ROUTE_CONFIDENCE_THRESHOLD=0.55
STM_WINDOW_TURNS=6
STM_SUMMARY_MAX_CHARS=300
STM_PERSIST_MAX_TURNS=16
LLM_BUDGET_PER_TURN=3
DATA_DIR=data

# ---------- 鉴权（★ 正式版必改） ----------
# mock    = user_token 形如 "uid:<任意串>" 即通过，客户端可伪造他人身份，
#           仅允许开发版 / 体验版联调，禁止进入正式版。
# wechat  = POST /v1/auth/login 用 wx.login code 换 openid，服务端签发不可伪造 token。
# trusted = 由上游网关鉴权后注入可信 uid 请求头，agent 只信网关不信客户端。
# 详见 contracts/v0.1/auth.md
AUTH_MODE=mock
WX_APPID=
WX_APP_SECRET=
